{
  "name": "claude-reel-studio",
  "version": "1.0.0",
  "description": "Plan-driven vertical reel generator. Author plans by hand or have Claude write them, then render to MP4.",
  "private": true,
  "scripts": {
    "dev": "remotion studio src/index.ts",
    "render": "remotion render src/index.ts",
    "create": "tsx bin/create.ts",
    "plan": "tsx bin/create.ts --no-tts --no-render",
    "tts": "tsx src/audio/generate-tts.ts",
    "record:browser": "tsx src/automation/playwright/record.ts",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.30.1",
    "@remotion/bundler": "^4.0.380",
    "@remotion/cli": "^4.0.380",
    "@remotion/captions": "^4.0.380",
    "@remotion/google-fonts": "^4.0.380",
    "@remotion/install-whisper-cpp": "^4.0.380",
    "@remotion/media-utils": "^4.0.380",
    "@remotion/noise": "^4.0.380",
    "@remotion/preload": "^4.0.380",
    "@remotion/renderer": "^4.0.380",
    "@remotion/shapes": "^4.0.380",
    "@remotion/transitions": "^4.0.380",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "remotion": "^4.0.380",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.7.0",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "playwright": "^1.47.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  },
  "engines": {
    "node": ">=18"
  }
}
